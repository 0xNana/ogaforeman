NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ogaforeman.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=456873235640
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
