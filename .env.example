# Runtime
OGA_ENV=local
DEMO_MODE=true
USE_FAKE_MODEL=true
DEFAULT_PROJECT_TIMEZONE=Africa/Accra

# Google Cloud (required in preview, staging, and production)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=
FIRESTORE_DATABASE=
FIRESTORE_LOCATION=
# Local/test only. Never set this in a deployed environment.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# Explicit local opt-in for remote Firestore. Requires GOOGLE_CLOUD_PROJECT, no emulator, and DEMO_MODE=false.
ALLOW_REMOTE_FIRESTORE_IN_LOCAL=false
MEDIA_BUCKET=
PUBSUB_SITE_EVENTS_TOPIC=
PUBSUB_DEAD_LETTER_TOPIC=
PUBSUB_WORKER_SUBSCRIPTION=

# Gemini. GEMINI_API_KEY enables the real Developer API locally without Cloud billing.
# Keep the key only in .env; deployed environments use Vertex configuration below.
GEMINI_API_KEY=
GEMINI_MODEL_ID=
GEMINI_FALLBACK_MODEL_ID=
GEMINI_LOCATION=
EVENT_CLAIM_LEASE_SECONDS=60
EVENT_CLAIM_MAX_ATTEMPTS=3
AGENT_WORKFLOW_TIMEOUT_SECONDS=45

# Identity Platform / Firebase Authentication
AUTH_ISSUER=
AUTH_AUDIENCE=

# Deployment-only defaults read by infra/deploy.sh; shell exports take precedence.
DEPLOY_ENVIRONMENT=staging
SCHEDULE_PROJECT_ID=
SCHEDULE_TIMEZONE=Africa/Accra
SCHEDULE_CRON="0 6 * * *"

# Safety and resource limits
SIGNED_UPLOAD_TTL_SECONDS=900
MAX_UPLOAD_BYTES=52428800
MAX_ATTACHMENT_COUNT=10
MAX_EVENT_TEXT_CHARS=20000
RATE_LIMIT_PER_USER=30
RATE_LIMIT_PER_PROJECT=300
APPROVAL_POLICY_VERSION=v1
